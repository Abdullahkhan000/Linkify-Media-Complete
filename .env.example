# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_DOMAIN=localhost:8000
SITE_NAME=Linkify Media
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ACCOUNT_EMAIL_VERIFICATION=mandatory

# Social login OAuth apps
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Application data
SQLITE_DB_PATH=/app/data/db.sqlite3

# Media provider
TMDB_API_KEY=

# AI support bot (optional; bot uses a safe fallback when the key is blank)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
SUPPORT_BOT_MODEL=gpt-5-mini
SUPPORT_BOT_MAX_TOKENS=700

# Email
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=support@linkifymedia.com

# Lemon Squeezy billing
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_BIZ=

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Host port
DJANGO_PORT=8000
