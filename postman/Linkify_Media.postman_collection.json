{
  "info": {
    "name": "Linkify Media API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000"},
    {"key": "api_key", "value": "lm_live_replace_me", "type": "secret"}
  ],
  "auth": {"type": "apikey", "apikey": [
    {"key": "key", "value": "X-API-Key", "type": "string"},
    {"key": "value", "value": "{{api_key}}", "type": "string"},
    {"key": "in", "value": "header", "type": "string"}
  ]},
  "item": [
    {"name": "Search", "request": {"method": "GET", "url": "{{base_url}}/api/v1/search/?q=Inception&type=movie&country=us"}},
    {"name": "Search results", "request": {"method": "GET", "url": "{{base_url}}/api/v1/search/results/?q=Dune&type=movie&page=1"}},
    {"name": "Trending", "request": {"method": "GET", "url": "{{base_url}}/api/v1/trending/?type=all"}},
    {"name": "Batch", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"items\":[{\"q\":\"Dune\",\"type\":\"movie\"}]}"}, "url": "{{base_url}}/api/v1/batch/"}},
    {"name": "Usage", "request": {"method": "GET", "url": "{{base_url}}/api/v1/usage/"}}
  ]
}
